---
const currentYear = new Date().getFullYear();
const onHome = (new URL(Astro.request.url).pathname) === '/';
const href = (hash: string) => (onHome ? `#${hash}` : `/#${hash}`);

const socials = [
  { name: 'X', label: 'X', href: 'https://x.com/marom_beltran' },
  { name: 'GitHub', label: 'Gh', href: 'https://github.com/marombeltran' },
  { name: 'LinkedIn', label: 'in', href: 'https://www.linkedin.com/in/marlon-beltran-526730203' },
];
---

<footer style="position:relative;z-index:1;border-top:1px solid var(--hair);background:var(--bg);">
  <div class="bs-footer-grid" style="max-width:1200px;margin:0 auto;padding:54px 24px 30px;display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:40px;">
    <div>
      <a href="/" style="display:flex;align-items:center;gap:10px;font-weight:800;font-size:17px;letter-spacing:-0.02em;color:var(--text);">
        <span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:7px;background:#4D6CFF;color:#fff;font-family:'JetBrains Mono',monospace;font-weight:600;font-size:14px;">B</span>
        Bitspace<span style="color:var(--text-3);font-weight:500;">Software</span>
      </a>
      <p style="margin:16px 0 0;max-width:300px;font-size:13.5px;line-height:1.6;color:var(--text-3);">Construimos software, automatizaciones e integraciones para empresas que necesitan operar con más control y menos fricción.</p>
      <div style="display:flex;gap:10px;margin-top:20px;">
        {socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name} style="display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:9px;border:1px solid var(--border);color:var(--text-2);font-size:13px;font-weight:600;">{s.label}</a>
        ))}
      </div>
    </div>

    <div>
      <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:var(--text-faint);margin-bottom:16px;">Navegación</div>
      <div style="display:flex;flex-direction:column;gap:11px;font-size:14px;color:var(--text-2);">
        <a href={href('capacidades')}>Servicios</a>
        <a href={href('productos')}>Productos</a>
        <a href={href('proceso')}>Proceso</a>
        <a href="/blog">Blog</a>
      </div>
    </div>

    <div>
      <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:var(--text-faint);margin-bottom:16px;">Conectar</div>
      <p style="margin:0 0 12px;font-size:13.5px;line-height:1.5;color:var(--text-3);">¿Tienes una pregunta o quieres colaborar?</p>
      <a href="mailto:hola@bitspace.software" style="display:inline-flex;align-items:center;gap:8px;font-size:14px;color:var(--accent-text);font-weight:500;">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5" stroke="currentColor" stroke-width="1.7" /><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.7" /></svg>
        hola@bitspace.software
      </a>
    </div>
  </div>

  <div style="max-width:1200px;margin:0 auto;padding:22px 24px;border-top:1px solid var(--hair);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;">
    <span style="font-size:12.5px;color:var(--text-faint);">© {currentYear} Bitspace Software. Todos los derechos reservados.</span>
    <span style="font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--text-faint);">Operaciones sin fricción.</span>
  </div>
</footer>

<style>
  @media (max-width: 760px) {
    .bs-footer-grid { grid-template-columns: 1fr !important; gap: 30px !important; }
  }
</style>
