---
// Skip to content link for accessibility
---
<a href="#main-content" class="bs-skip">Saltar al contenido principal</a>

<style>
  .bs-skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--accent);
    color: #fff;
    padding: 10px 16px;
    border-radius: 9px;
    font-size: 14px;
    font-weight: 600;
  }
  .bs-skip:focus {
    left: 16px;
    top: 16px;
  }
</style>
