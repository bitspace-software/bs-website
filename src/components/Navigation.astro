---
const pathname = new URL(Astro.request.url).pathname;
const onHome = pathname === '/' || pathname === '';
const href = (hash: string) => (onHome ? `#${hash}` : `/#${hash}`);
---

<!-- Fixed nav — matches design 1:1 -->
<nav style="position:fixed;top:0;left:0;right:0;z-index:50;height:66px;display:flex;align-items:center;background:var(--nav-bg);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--hair);">
  <div style="max-width:1200px;margin:0 auto;padding:0 24px;width:100%;display:flex;align-items:center;justify-content:space-between;">
    <a href={onHome ? '#top' : '/'} style="display:flex;align-items:center;gap:10px;font-weight:800;font-size:17px;letter-spacing:-0.02em;color:var(--text);">
      <span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:7px;background:#4D6CFF;color:#fff;font-family:'JetBrains Mono',monospace;font-weight:600;font-size:14px;">B</span>
      Bitspace<span style="color:var(--text-3);font-weight:500;">Software</span>
    </a>
    <div data-r="navlinks" style="display:flex;align-items:center;gap:30px;">
      <a href={href('capacidades')} style="font-size:14px;color:var(--text-2);font-weight:500;">Servicios</a>
      <a href={href('productos')} style="font-size:14px;color:var(--text-2);font-weight:500;">Productos</a>
      <a href={href('proceso')} style="font-size:14px;color:var(--text-2);font-weight:500;">Proceso</a>
      <a href="/blog" style="font-size:14px;color:var(--text-2);font-weight:500;">Blog</a>
      <a href={href('contacto')} style="display:inline-flex;align-items:center;gap:7px;background:var(--text);color:var(--bg);font-weight:600;font-size:14px;padding:9px 17px;border-radius:8px;">Hablar con ventas</a>
    </div>
  </div>
</nav>

<style>
  /* Match design: on small screens only the CTA stays visible */
  @media (max-width: 760px) {
    [data-r="navlinks"] a:not(:last-child) { display: none !important; }
  }
</style>
