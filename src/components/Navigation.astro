---
const pathname = new URL(Astro.request.url).pathname;
---

<header class="sticky top-0 z-40 w-full bg-white/80 dark:bg-zinc-900/80 backdrop-blur-sm border-b border-zinc-100/50 dark:border-zinc-800/50">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">

      <!-- Logo -->
      <a href="/" class="flex items-center">
        <span class="text-xl font-normal tracking-tight">
          <span class="text-primary-600 dark:text-[#FFBF00]">Bitspace</span>
          <span class="hidden sm:inline text-zinc-900 dark:text-white ml-1">Software</span>
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex md:items-center md:gap-7">

        <a href="/#servicios"
          class="text-sm font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white transition-colors">
          Servicios
        </a>

        <!-- Productos Dropdown -->
        <div class="relative group">
          <button class="flex items-center gap-1 text-sm font-medium text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white transition-colors py-5">
            Productos
            <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div class="absolute top-full -left-2 pt-1 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-150 z-50">
            <div class="bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 rounded-xl shadow-lg overflow-hidden">
              <a href="/financial-os"
                class="flex flex-col px-4 py-3 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors">
                <span class="text-sm font-medium text-zinc-900 dark:text-white">Financial OS</span>
                <span class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">Gestión financiera operacional</span>
              </a>
              <div class="border-t border-zinc-100 dark:border-zinc-800"></div>
              <a href="/bulk-invoice"
                class="flex flex-col px-4 py-3 hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors">
                <span class="text-sm font-medium text-zinc-900 dark:text-white">Bulk Invoice</span>
                <span class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">Facturación masiva automatizada</span>
              </a>
            </div>
          </div>
        </div>

        <a href="/blog"
          class={`text-sm font-medium transition-colors ${pathname.startsWith('/blog') ? 'text-zinc-900 dark:text-white' : 'text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-white'}`}>
          Blog
        </a>

        <!-- Theme Toggle -->
        <button
          id="theme-toggle"
          class="p-2 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors"
          aria-label="Cambiar tema"
          onclick="window.toggleTheme()"
        >
          <svg class="w-5 h-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </button>

        <!-- CTA Button -->
        <a
          href="https://wa.me/50578410264"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 text-sm font-semibold rounded-lg hover:bg-zinc-700 dark:hover:bg-zinc-100 transition-colors"
        >
          Contacto
        </a>

      </nav>

      <!-- Mobile: theme + hamburger -->
      <div class="flex items-center gap-1 md:hidden">
        <button
          id="mobile-theme-toggle"
          class="p-2 text-zinc-600 dark:text-zinc-400"
          aria-label="Cambiar tema"
          onclick="window.toggleTheme()"
        >
          <svg class="w-5 h-5 dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </button>
        <button
          id="mobile-menu-button"
          class="p-2 text-zinc-900 dark:text-white"
          aria-label="Menú"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>
</header>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="fixed inset-0 z-50 bg-white/95 dark:bg-zinc-950/95 backdrop-blur-xl flex flex-col opacity-0 pointer-events-none transition-all duration-300">
  <div class="flex justify-between items-center px-6 py-4 border-b border-zinc-100 dark:border-zinc-800">
    <a href="/" class="text-xl font-normal tracking-tight">
      <span class="text-primary-600 dark:text-[#FFBF00]">Bitspace</span>
      <span class="text-zinc-900 dark:text-white ml-1">Software</span>
    </a>
    <button id="close-menu-button" class="p-2 text-zinc-900 dark:text-white rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-800 transition-colors" aria-label="Cerrar menú">
      <svg fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav class="flex-1 flex flex-col px-6 py-6 space-y-1 overflow-y-auto">
    <a href="/#servicios" class="mobile-nav-item opacity-0 translate-y-4 py-3.5 text-lg font-medium text-zinc-900 dark:text-white border-b border-zinc-100 dark:border-zinc-800">
      Servicios
    </a>

    <div class="mobile-nav-item opacity-0 translate-y-4 border-b border-zinc-100 dark:border-zinc-800 pb-3">
      <p class="py-3.5 text-lg font-medium text-zinc-900 dark:text-white">Productos</p>
      <div class="pl-4 space-y-2">
        <a href="/financial-os" class="block py-1.5 text-base text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors">Financial OS</a>
        <a href="/bulk-invoice" class="block py-1.5 text-base text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-colors">Bulk Invoice</a>
      </div>
    </div>

    <a href="/blog" class="mobile-nav-item opacity-0 translate-y-4 py-3.5 text-lg font-medium text-zinc-900 dark:text-white border-b border-zinc-100 dark:border-zinc-800">
      Blog
    </a>

    <div class="mobile-nav-item opacity-0 translate-y-4 pt-6">
      <a
        href="https://wa.me/50578410264"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full py-3.5 bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 font-semibold rounded-xl transition-colors"
      >
        Contacto por WhatsApp
      </a>
    </div>
  </nav>
</div>


<script>
  document.addEventListener('DOMContentLoaded', () => {
    const mobileMenuButton = document.getElementById('mobile-menu-button');
    const closeMenuButton = document.getElementById('close-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    const navItems = document.querySelectorAll('.mobile-nav-item');

    const openMenu = () => {
      if (!mobileMenu) return;
      document.body.style.overflow = 'hidden';
      mobileMenu.classList.remove('pointer-events-none');
      mobileMenu.classList.add('pointer-events-auto');
      setTimeout(() => {
        mobileMenu.style.opacity = '1';
        navItems.forEach(item => {
          setTimeout(() => item.classList.remove('opacity-0', 'translate-y-4'), 150);
        });
      }, 50);
    };

    const closeMenu = () => {
      if (!mobileMenu) return;
      navItems.forEach(item => item.classList.add('opacity-0', 'translate-y-4'));
      setTimeout(() => {
        mobileMenu.style.opacity = '0';
        setTimeout(() => {
          mobileMenu.classList.remove('pointer-events-auto');
          mobileMenu.classList.add('pointer-events-none');
          document.body.style.overflow = '';
        }, 300);
      }, 100);
    };

    mobileMenuButton?.addEventListener('click', openMenu);
    closeMenuButton?.addEventListener('click', closeMenu);
    mobileMenu?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileMenu?.classList.contains('pointer-events-auto')) closeMenu();
    });
  });
</script>

<style>
  .mobile-nav-item {
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  #mobile-menu {
    transition: opacity 0.3s ease;
  }
</style>
