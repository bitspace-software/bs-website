---
const pathname = new URL(Astro.request.url).pathname;
const onHome = pathname === '/' || pathname === '';
const href = (hash: string) => (onHome ? `#${hash}` : `/#${hash}`);
const WA = 'https://wa.me/50378410264';
---

<header
  style="position:sticky;top:0;z-index:50;height:64px;display:flex;align-items:center;background:var(--nav-bg);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--hair);"
>
  <div style="max-width:1200px;margin:0 auto;padding:0 24px;width:100%;display:flex;align-items:center;justify-content:space-between;gap:16px;">
    <!-- Logo -->
    <a href="/" style="display:flex;align-items:center;gap:10px;font-weight:800;font-size:17px;letter-spacing:-0.02em;color:var(--text);">
      <span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:7px;background:#4D6CFF;color:#fff;font-family:'JetBrains Mono',monospace;font-weight:600;font-size:14px;">B</span>
      Bitspace<span style="color:var(--text-3);font-weight:500;">Software</span>
    </a>

    <!-- Desktop links -->
    <nav class="bs-navlinks" style="display:flex;align-items:center;gap:28px;">
      <a href={href('capacidades')} style="font-size:14px;color:var(--text-2);font-weight:500;">Servicios</a>
      <a href={href('productos')} style="font-size:14px;color:var(--text-2);font-weight:500;">Productos</a>
      <a href={href('proceso')} style="font-size:14px;color:var(--text-2);font-weight:500;">Proceso</a>
      <a href="/blog" style={`font-size:14px;font-weight:500;color:${pathname.startsWith('/blog') ? 'var(--text)' : 'var(--text-2)'};`}>Blog</a>

      <!-- Theme toggle -->
      <button
        type="button"
        onclick="window.toggleTheme()"
        aria-label="Cambiar tema"
        style="display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:9px;border:1px solid var(--border-2);background:var(--surface);color:var(--text-2);cursor:pointer;"
      >
        <svg style="display:block" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
        </svg>
      </button>

      <a href={href('contacto')} style="display:inline-flex;align-items:center;gap:7px;background:var(--text);color:var(--bg);font-weight:600;font-size:14px;padding:9px 17px;border-radius:8px;">Hablar con ventas</a>
    </nav>

    <!-- Mobile controls -->
    <div class="bs-mobilectrl" style="display:none;align-items:center;gap:6px;">
      <button type="button" onclick="window.toggleTheme()" aria-label="Cambiar tema" style="display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:9px;border:1px solid var(--border-2);background:var(--surface);color:var(--text-2);cursor:pointer;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /></svg>
      </button>
      <button id="bs-menu-open" type="button" aria-label="Abrir menú" style="display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:9px;border:1px solid var(--border-2);background:var(--surface);color:var(--text);cursor:pointer;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu overlay -->
<div id="bs-mobile-menu" style="position:fixed;inset:0;z-index:60;background:var(--bg);opacity:0;pointer-events:none;transition:opacity .25s ease;display:flex;flex-direction:column;">
  <div style="height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;border-bottom:1px solid var(--hair);">
    <a href="/" style="display:flex;align-items:center;gap:10px;font-weight:800;font-size:17px;letter-spacing:-0.02em;color:var(--text);">
      <span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:7px;background:#4D6CFF;color:#fff;font-family:'JetBrains Mono',monospace;font-weight:600;font-size:14px;">B</span>
      Bitspace<span style="color:var(--text-3);font-weight:500;">Software</span>
    </a>
    <button id="bs-menu-close" type="button" aria-label="Cerrar menú" style="display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:9px;border:1px solid var(--border-2);background:var(--surface);color:var(--text);cursor:pointer;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
    </button>
  </div>
  <nav style="display:flex;flex-direction:column;padding:14px 24px;gap:2px;">
    <a href={href('capacidades')} class="bs-mlink">Servicios</a>
    <a href={href('productos')} class="bs-mlink">Productos</a>
    <a href={href('proceso')} class="bs-mlink">Proceso</a>
    <a href="/blog" class="bs-mlink">Blog</a>
    <a href={WA} target="_blank" rel="noopener noreferrer" style="margin-top:14px;display:inline-flex;align-items:center;justify-content:center;gap:8px;background:#4D6CFF;color:#fff;font-weight:600;font-size:15px;padding:14px;border-radius:9px;">Contacto por WhatsApp</a>
  </nav>
</div>

<style>
  .bs-mlink {
    padding: 14px 4px;
    font-size: 18px;
    font-weight: 600;
    color: var(--text);
    border-bottom: 1px solid var(--hair);
  }
  @media (max-width: 820px) {
    .bs-navlinks { display: none !important; }
    .bs-mobilectrl { display: flex !important; }
  }
</style>

<script is:inline>
  (function () {
    var menu = document.getElementById('bs-mobile-menu');
    var open = document.getElementById('bs-menu-open');
    var close = document.getElementById('bs-menu-close');
    function setOpen(v) {
      if (!menu) return;
      menu.style.opacity = v ? '1' : '0';
      menu.style.pointerEvents = v ? 'auto' : 'none';
      document.body.style.overflow = v ? 'hidden' : '';
    }
    open && open.addEventListener('click', function () { setOpen(true); });
    close && close.addEventListener('click', function () { setOpen(false); });
    menu && menu.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { setOpen(false); }); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') setOpen(false); });
  })();
</script>
