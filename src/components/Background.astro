---
// Background.astro — ambient glow that sits behind all content.
---
<div aria-hidden="true" style="pointer-events:none;position:fixed;inset:0;z-index:-10;overflow:hidden;">
  <div
    style="position:absolute;top:-220px;left:50%;transform:translateX(-60%);width:900px;height:620px;max-width:120vw;background:radial-gradient(ellipse at center,var(--glow),transparent 65%);filter:blur(20px);"
  ></div>
</div>
