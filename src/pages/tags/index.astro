---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Get all unique tags from blog posts
const allPosts = await getCollection('blog');
const tags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))].sort();

// Count posts for each tag
const tagObjects = tags.map((tag) => ({
  name: tag,
  count: allPosts.filter((post) => post.data.tags?.includes(tag)).length,
}));

// Sort by post count (most first)
const sortedTags = [...tagObjects].sort((a, b) => b.count - a.count);
---

<Layout title="Etiquetas del blog">
  <section style="position:relative;z-index:1;max-width:860px;margin:0 auto;padding:60px 24px 90px;">
    <div style="text-align:center;max-width:640px;margin:0 auto;">
      <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:var(--accent-text);font-weight:500;">Etiquetas</div>
      <h2 style="margin:16px 0 0;font-weight:700;font-size:clamp(30px,4vw,46px);line-height:1.05;letter-spacing:-0.025em;color:var(--text);">Explora por tema</h2>
      <p style="margin:18px 0 0;font-size:17px;line-height:1.6;color:var(--text-2);">Encuentra artículos organizados por los temas que te interesan.</p>
    </div>

    {sortedTags.length === 0 ? (
      <div style="text-align:center;margin-top:54px;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:44px 30px;">
        <p style="margin:0;font-size:18px;font-weight:600;color:var(--text);">Aún no hay etiquetas.</p>
        <p style="margin:8px 0 0;font-size:14px;line-height:1.6;color:var(--text-3);">Vuelve pronto para ver contenido categorizado.</p>
      </div>
    ) : (
      <div style="margin-top:54px;background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:clamp(24px,4vw,36px);">
        <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:var(--text-faint);font-weight:500;margin-bottom:22px;">
          {sortedTags.length} etiqueta{sortedTags.length !== 1 ? 's' : ''}
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:10px;">
          {sortedTags.map((tag) => (
            <a
              href={`/tags/${tag.name}`}
              class="tag-pill"
              style="display:inline-flex;align-items:center;gap:9px;font-family:'JetBrains Mono',monospace;font-size:13px;letter-spacing:0.02em;background:var(--accent-soft);border:1px solid var(--accent-border);color:var(--accent-text);padding:6px 14px;border-radius:100px;transition:border-color 0.2s ease;"
            >
              <span>{tag.name}</span>
              <span style="color:var(--text-3);">·</span>
              <span style="color:var(--text-3);">{tag.count}</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
</Layout>

<style>
  @media (hover: hover) {
    .tag-pill:hover { border-color: var(--accent-text); }
  }
</style>
