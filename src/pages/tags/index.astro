---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Get all unique tags from blog posts
const allPosts = await getCollection('blog');
const tags = [...new Set(allPosts.flatMap(post => post.data.tags || []))].sort();

// Count posts for each tag
const tagObjects = tags.map(tag => ({
  name: tag,
  count: allPosts.filter(post => post.data.tags?.includes(tag)).length,
}));

// Sort by post count (most first)
const sortedTags = [...tagObjects].sort((a, b) => b.count - a.count);
---

<Layout title="Temas del blog">
  <div class="w-full max-w-5xl mx-auto px-4 sm:px-6 pt-12 pb-16 md:pt-20 md:pb-24">
    <!-- Section header — matches homepage style -->
    <div class="relative mb-12 sm:mb-16">
      <div class="absolute -top-12 -left-12 w-56 sm:w-72 h-56 sm:h-72 rounded-full blur-3xl pointer-events-none" style="background:var(--glow);opacity:0.55;"></div>
      <div class="absolute -bottom-12 -right-12 w-56 sm:w-72 h-56 sm:h-72 rounded-full blur-3xl pointer-events-none" style="background:var(--glow);opacity:0.4;"></div>

      <div class="relative text-center max-w-2xl mx-auto">
        <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:var(--accent-text);font-weight:500;">Temas</div>
        <h1 style="margin:16px 0 0;font-weight:700;font-size:clamp(30px,4vw,46px);line-height:1.05;letter-spacing:-0.025em;color:var(--text);">
          Explora por tema
        </h1>
        <p style="margin:18px 0 0;font-size:17px;line-height:1.6;color:var(--text-2);">
          Encuentra artículos organizados por los temas que te interesan.
        </p>
      </div>
    </div>

    {tags.length === 0 ? (
      <div class="text-center py-16">
        <p style="font-size:18px;font-weight:600;color:var(--text);">Aún no hay temas.</p>
        <p style="margin-top:8px;font-size:14px;color:var(--text-3);">Vuelve pronto para ver contenido categorizado.</p>
      </div>
    ) : (
      <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:clamp(20px,4vw,36px);">
        <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.16em;text-transform:uppercase;color:var(--text-faint);font-weight:500;margin-bottom:22px;">
          {sortedTags.length} tema{sortedTags.length !== 1 ? 's' : ''}
        </div>
        <div class="flex flex-wrap gap-2.5">
          {sortedTags.map((tag) => (
            <a
              href={`/tags/${tag.name}`}
              class="tag-pill inline-flex items-center gap-2"
              style="font-family:'JetBrains Mono',monospace;font-size:13px;letter-spacing:0.02em;background:var(--accent-soft);border:1px solid var(--accent-border);color:var(--accent-text);padding:8px 14px;border-radius:100px;transition:border-color 0.2s ease,background 0.2s ease;"
            >
              <span>{tag.name}</span>
              <span style="font-size:11px;color:var(--text-3);">{tag.count}</span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</Layout>

<style>
  @media (hover: hover) {
    .tag-pill:hover {
      border-color: var(--accent-text) !important;
      background: var(--accent-soft) !important;
    }
  }
</style>
