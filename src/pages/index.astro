  <!-- ===== PARA QUIÉN ===== -->
  <section style="position:relative;z-index:1;max-width:1100px;margin:0 auto;padding:100px 24px;" data-r="pad">
    <div style="text-align:center;max-width:640px;margin:0 auto;">
      <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:var(--accent-text);font-weight:500;">Para quién trabajamos</div>
