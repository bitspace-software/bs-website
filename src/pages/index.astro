---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const WA = 'https://wa.me/50378410264';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 2);

const fmtDate = (d: Date) =>
  d.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

const problems = [
  { n: '01', t: 'Procesos manuales que no escalan', d: 'Tu equipo ingresa datos en múltiples sistemas, copia información entre hojas de cálculo y pierde horas en tareas que deberían ser automáticas.' },
  { n: '02', t: 'Sistemas desconectados', d: 'Tu ERP no habla con tu tienda en línea. Tu CRM no se actualiza con las ventas. Cada integración es un proceso manual propenso a errores.' },
  { n: '03', t: 'Sin visibilidad real de la operación', d: 'Los reportes tardan días en estar listos. No sabes tu inventario real, tu caja actual o el estado de tus pedidos sin preguntarle a alguien.' },
  { n: '04', t: 'Facturación lenta y propensa a errores', d: 'Emitir cientos de facturas consume horas, requiere revisión manual y genera inconsistencias que llegan al cliente.' },
  { n: '05', t: 'Crecimiento bloqueado por procesos rígidos', d: 'A medida que crece la operación, los procesos manuales colapsan. Lo que funcionaba con 5 personas ya no funciona con 20.' },
  { n: '06', t: 'Dependencia total del desarrollo externo', d: 'Cualquier ajuste o configuración requiere contratar desarrollo. Tu operación no puede moverse a tu ritmo.' },
];

const fit = [
  { t: 'Empresas medianas con operaciones complejas', d: 'Entre 10 y 200 personas. Con flujos que hoy dependen de personas específicas o de hojas de cálculo.' },
  { t: 'Empresas con sistemas desconectados', d: 'Que usan 3 o más herramientas y ninguna se habla con las otras. La sincronización manual consume tiempo cada día.' },
  { t: 'Empresas en crecimiento que sus procesos no acompañan', d: 'Que han escalado en ventas pero no en infraestructura operacional. Donde lo que funcionaba antes ya no alcanza.' },
  { t: 'Equipos sin capacidad técnica interna', d: 'Que necesitan un socio que entienda su operación, no solo que escriba código.' },
];

const notFit = [
  { t: 'Buscas una landing page o sitio corporativo simple', d: 'Hay agencias especializadas en web design que te van a servir mejor y más rápido.' },
  { t: 'Estás en etapa de idea sin tracción', d: 'No construimos MVPs para validar hipótesis sin claridad del problema que se resuelve.' },
  { t: 'Necesitas horas de desarrollo sin un problema definido', d: 'No vendemos tiempo. Vendemos soluciones a problemas operacionales concretos.' },
  { t: 'Quieres el stack tecnológico más reciente como objetivo', d: 'Usamos tecnología porque resuelve el problema, no para experimentar con lo nuevo.' },
];

const steps = [
  { n: '01', t: 'Diagnóstico operacional', d: 'Antes de escribir código, entendemos tu operación. ¿Qué procesos tienes? ¿Cuáles fallan? ¿Dónde se pierde tiempo? Una sesión de trabajo conjunto, sin costo.' },
  { n: '02', t: 'Propuesta enfocada', d: 'Definimos qué se construye, qué se integra y qué se automatiza. Alcance claro, tiempos realistas. Te presentamos la propuesta antes de cualquier compromiso.' },
  { n: '03', t: 'Desarrollo iterativo', d: 'Construimos en entregas cortas. Ves resultados reales desde las primeras semanas, no al final de un proyecto de 6 meses.' },
  { n: '04', t: 'Operación y soporte', d: 'Entregamos soluciones que tu equipo puede operar sin depender de nosotros. Y cuando necesitas ayuda, estamos disponibles.' },
];

const stack = [
  { label: 'Aplicaciones', items: ['Laravel', 'Django', 'React', 'Astro', 'TypeScript'] },
  { label: 'Datos e integración', items: ['PostgreSQL', 'Redis', 'Airflow', 'APIs REST', 'Python'] },
  { label: 'Infraestructura', items: ['AWS', 'Docker', 'CI/CD', 'GitHub', 'Vercel'] },
];
---

<Layout title="Bitspace Software — Automatización operacional y software a medida">
  <!-- ===== HERO ===== -->
  <section id="top" data-r="hero" style="position:relative;z-index:1;max-width:1200px;margin:0 auto;padding:142px 24px 96px;display:grid;grid-template-columns:1.06fr 0.94fr;gap:60px;align-items:center;">
    <div>
      <div style="display:inline-flex;align-items:center;gap:9px;border:1px solid var(--border-2);background:var(--surface);border-radius:100px;padding:6px 13px;font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-2);">
        <span style="width:7px;height:7px;border-radius:50%;background:#2FCB72;box-shadow:0 0 10px #2FCB72;animation:bsPulse 1.8s ease-in-out infinite;"></span>
        15 años · Automatización operacional
      </div>
      <h1 style="margin:26px 0 0;font-weight:800;font-size:clamp(33px,5.4vw,70px);line-height:1.03;letter-spacing:-0.035em;color:var(--text);">
        Automatizamos los procesos que <span style="color:var(--accent-text);">no deberían ser manuales.</span>
      </h1>
      <p style="margin:26px 0 0;font-size:18px;line-height:1.62;color:var(--text-2);max-width:540px;">
        Construimos software a medida, automatizaciones e integraciones para empresas que ya tocaron el techo de lo que pueden hacer con hojas de cálculo. Cero código genérico. Foco total en resultados medibles.
      </p>
      <div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:34px;">
        <a href={WA} target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:9px;background:#4D6CFF;color:#fff;font-weight:600;font-size:15.5px;padding:15px 24px;border-radius:9px;box-shadow:0 8px 28px rgba(77,108,255,0.35);">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Z" stroke="#fff" stroke-width="1.8" /><path d="M8.5 9.2c.2-.5.4-.5.6-.5h.5c.2 0 .4 0 .6.4l.7 1.6c.1.2 0 .4-.1.6l-.5.5c-.1.1-.2.3-.1.5.3.6 1.4 1.9 2.7 2.3.2.1.4 0 .5-.1l.5-.6c.2-.2.3-.2.6-.1l1.6.8c.2.1.3.3.3.5 0 .9-.7 1.6-1.6 1.6-2.7 0-6.6-3.9-6.6-6.6 0-.5.2-.9.4-1.3Z" fill="#fff" /></svg>
          Habla con nosotros
        </a>
        <a href="#capacidades" style="display:inline-flex;align-items:center;gap:9px;background:transparent;color:var(--text);font-weight:600;font-size:15.5px;padding:15px 22px;border-radius:9px;border:1px solid var(--border-2);">
          Ver capacidades
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </a>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:14px 28px;margin-top:40px;padding-top:28px;border-top:1px solid var(--hair);font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--text-3);letter-spacing:0.01em;">
        <span><span style="color:var(--text);font-weight:600;">15 años</span> en operaciones</span>
        <span style="color:var(--border-2);">/</span>
        <span>Empresas de <span style="color:var(--text);font-weight:600;">10–200</span> personas</span>
        <span style="color:var(--border-2);">/</span>
        <span>Manufactura · Servicios · Logística</span>
      </div>
    </div>

    <!-- console panel (always dark) -->
    <div style="position:relative;">
      <div style="position:relative;background:linear-gradient(180deg,#101218,#0B0C10);border:1px solid #23252D;border-radius:16px;overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,0.5);">
        <div style="position:absolute;inset:0;overflow:hidden;pointer-events:none;"><div style="position:absolute;left:0;right:0;height:120px;background:linear-gradient(180deg,transparent,rgba(77,108,255,0.07),transparent);animation:bsScan 6s linear infinite;"></div></div>
        <div style="display:flex;align-items:center;justify-content:space-between;padding:13px 16px;border-bottom:1px solid #1C1E25;">
          <div style="display:flex;align-items:center;gap:7px;">
            <span style="width:10px;height:10px;border-radius:50%;background:#2B2D34;"></span>
            <span style="width:10px;height:10px;border-radius:50%;background:#2B2D34;"></span>
            <span style="width:10px;height:10px;border-radius:50%;background:#2B2D34;"></span>
          </div>
          <span style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.1em;text-transform:uppercase;color:#6E86FF;display:inline-flex;align-items:center;gap:6px;"><span style="width:6px;height:6px;border-radius:50%;background:#2FCB72;animation:bsPulse 1.8s infinite;"></span>operación · en vivo</span>
        </div>
        <div style="padding:18px 18px 8px;display:flex;flex-direction:column;gap:11px;font-family:'JetBrains Mono',monospace;font-size:12.5px;">
          <div style="display:flex;align-items:center;justify-content:space-between;padding:13px 14px;background:#0E1015;border:1px solid #1E2028;border-radius:10px;">
            <span style="color:#C7CAD2;">Sincronización ERP ↔ Inventario</span>
            <span style="display:inline-flex;align-items:center;gap:6px;color:#2FCB72;">✓ <span style="color:#6E6F78;">120ms</span></span>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:13px 14px;background:#0E1015;border:1px solid #1E2028;border-radius:10px;">
            <span style="color:#C7CAD2;">Facturación masiva · lote</span>
            <span style="display:inline-flex;align-items:center;gap:6px;color:#2FCB72;">✓ <span style="color:#6E6F78;">1,240 docs</span></span>
          </div>
          <div style="display:flex;align-items:center;justify-content:space-between;padding:13px 14px;background:#0E1015;border:1px solid #1E2028;border-radius:10px;">
            <span style="color:#C7CAD2;">Alerta de stock crítico</span>
            <span style="display:inline-flex;align-items:center;gap:6px;color:#FF6A2C;">→ enviada</span>
          </div>
        </div>
        <div style="padding:6px 18px 20px;display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div style="padding:15px;background:#0E1015;border:1px solid #1E2028;border-radius:10px;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.1em;text-transform:uppercase;color:#7C7F89;">Horas / mes recuperadas</div>
            <div style="margin-top:8px;font-weight:800;font-size:30px;letter-spacing:-0.03em;color:#F7F7F8;">+180</div>
          </div>
          <div style="padding:15px;background:#0E1015;border:1px solid #1E2028;border-radius:10px;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:10.5px;letter-spacing:0.1em;text-transform:uppercase;color:#7C7F89;">Errores manuales</div>
            <div style="margin-top:8px;font-weight:800;font-size:30px;letter-spacing:-0.03em;color:#6E86FF;">−94%</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== PROBLEMAS ===== -->
  <section style="position:relative;z-index:1;background:var(--bg-alt);border-top:1px solid var(--hair);border-bottom:1px solid var(--hair);">
    <div style="max-width:1200px;margin:0 auto;padding:96px 24px;" data-r="pad">
      <div style="text-align:center;max-width:640px;margin:0 auto;">
        <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:var(--accent-text);font-weight:500;">Problemas que resolvemos</div>
        <h2 style="margin:16px 0 0;font-weight:700;font-size:clamp(30px,4vw,46px);line-height:1.05;letter-spacing:-0.025em;color:var(--text);">¿Reconoces alguno de estos cuellos de botella?</h2>
        <p style="margin:18px 0 0;font-size:17px;line-height:1.6;color:var(--text-2);">Son las fricciones operacionales que más frenan a empresas en crecimiento. Si alguna te suena familiar, hay algo que arreglar — y nosotros lo arreglamos.</p>
      </div>
      <div data-r="grid3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:54px;">
        {problems.map((p) => (
          <div style="background:var(--surface);border:1px solid var(--border);border-radius:14px;padding:26px;">
            <div style="font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--orange);font-weight:600;">{p.n}</div>
            <h3 style="margin:14px 0 9px;font-weight:700;font-size:18px;letter-spacing:-0.01em;color:var(--text);">{p.t}</h3>
            <p style="margin:0;font-size:14.5px;line-height:1.6;color:var(--text-2);">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== CAPACIDADES ===== -->
  <section id="capacidades" style="position:relative;z-index:1;max-width:1200px;margin:0 auto;padding:100px 24px;" data-r="pad">
    <div style="text-align:center;max-width:640px;margin:0 auto;">
      <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:var(--accent-text);font-weight:500;">Capacidades</div>
      <h2 style="margin:16px 0 0;font-weight:700;font-size:clamp(30px,4vw,46px);line-height:1.05;letter-spacing:-0.025em;color:var(--text);">Lo que construimos para resolverlos</h2>
      <p style="margin:18px 0 0;font-size:17px;line-height:1.6;color:var(--text-2);">No vendemos proyectos de software genérico. Construimos herramientas operacionales que resuelven problemas concretos y se integran a cómo ya trabaja tu empresa.</p>
    </div>
    <div data-r="grid3" style="display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:54px;">
      <div style="position:relative;background:var(--surface);border:1px solid var(--border-2);border-radius:16px;padding:30px;overflow:hidden;">
        <div style="position:absolute;top:-40px;right:-40px;width:140px;height:140px;background:radial-gradient(circle,rgba(77,108,255,0.16),transparent 70%);"></div>
        <div style="display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:11px;background:#4D6CFF;box-shadow:0 8px 22px rgba(77,108,255,0.4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z" fill="#fff" /></svg>
        </div>
        <h3 style="margin:18px 0 10px;font-weight:700;font-size:20px;letter-spacing:-0.02em;color:var(--text);">Automatización</h3>
        <p style="margin:0;font-size:14.5px;line-height:1.6;color:var(--text-2);">Diseñamos flujos que corren solos: alertas automáticas, procesamiento de pedidos, sincronización entre sistemas, generación de documentos y notificaciones a equipos.</p>
        <div style="margin-top:22px;padding-top:18px;border-top:1px solid var(--border);font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--green);">Resultado: menos errores, más velocidad de respuesta.</div>
      </div>
      <div style="position:relative;background:var(--surface);border:1px solid var(--border-2);border-radius:16px;padding:30px;overflow:hidden;">
        <div style="position:absolute;top:-40px;right:-40px;width:140px;height:140px;background:radial-gradient(circle,rgba(255,106,44,0.14),transparent 70%);"></div>
        <div style="display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:11px;background:#FF6A2C;box-shadow:0 8px 22px rgba(255,106,44,0.34);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 12a4 4 0 0 1 4-4h3a4 4 0 0 1 0 8h-1" stroke="#fff" stroke-width="1.9" stroke-linecap="round" /><path d="M15 12a4 4 0 0 1-4 4H8a4 4 0 0 1 0-8h1" stroke="#fff" stroke-width="1.9" stroke-linecap="round" /></svg>
        </div>
        <h3 style="margin:18px 0 10px;font-weight:700;font-size:20px;letter-spacing:-0.02em;color:var(--text);">Integraciones</h3>
        <p style="margin:0;font-size:14.5px;line-height:1.6;color:var(--text-2);">Conectamos sistemas que hoy no se hablan: ERP con tienda en línea, CRM con facturación, logística con inventario. Creamos el puente que faltaba sin reemplazar lo que ya tienes.</p>
        <div style="margin-top:22px;padding-top:18px;border-top:1px solid var(--border);font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--green);">Resultado: operación fluida sin cambiar de plataforma.</div>
      </div>
      <div style="position:relative;background:var(--surface);border:1px solid var(--border-2);border-radius:16px;padding:30px;overflow:hidden;">
        <div style="position:absolute;top:-40px;right:-40px;width:140px;height:140px;background:radial-gradient(circle,rgba(77,108,255,0.16),transparent 70%);"></div>
        <div style="display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border-radius:11px;background:#4D6CFF;box-shadow:0 8px 22px rgba(77,108,255,0.4);">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19V11M12 19V5M19 19v-6" stroke="#fff" stroke-width="2.1" stroke-linecap="round" /></svg>
        </div>
        <h3 style="margin:18px 0 10px;font-weight:700;font-size:20px;letter-spacing:-0.02em;color:var(--text);">Software operacional</h3>
        <p style="margin:0;font-size:14.5px;line-height:1.6;color:var(--text-2);">Cuando las herramientas genéricas no bastan, construimos módulos a medida: gestión de contratos, control de inventario, paneles de aprobaciones y reportería en tiempo real.</p>
        <div style="margin-top:22px;padding-top:18px;border-top:1px solid var(--border);font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--green);">Resultado: control total sin depender de hojas de cálculo.</div>
      </div>
    </div>
  </section>

  <!-- ===== PRODUCTOS ===== -->
  <section id="productos" style="position:relative;z-index:1;background:var(--bg-alt);border-top:1px solid var(--hair);border-bottom:1px solid var(--hair);">
    <div style="max-width:1100px;margin:0 auto;padding:100px 24px;" data-r="pad">
      <div style="text-align:center;max-width:600px;margin:0 auto;">
        <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:var(--accent-text);font-weight:500;">Productos</div>
        <h2 style="margin:16px 0 0;font-weight:700;font-size:clamp(30px,4vw,46px);line-height:1.05;letter-spacing:-0.025em;color:var(--text);">Soluciones listas para operar</h2>
        <p style="margin:18px 0 0;font-size:17px;line-height:1.6;color:var(--text-2);">Además de proyectos a medida, desarrollamos productos propios que resuelven problemas operacionales frecuentes. Más rápidos de implementar, adaptables a tu operación.</p>
      </div>
      <div data-r="grid2" style="display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:54px;">
        <div style="position:relative;background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:32px;overflow:hidden;">
          <div style="position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#4D6CFF,transparent);"></div>
          <div style="display:flex;align-items:center;gap:13px;">
            <div style="display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:11px;background:#4D6CFF;font-family:'JetBrains Mono',monospace;font-weight:600;color:#fff;font-size:15px;">F</div>
            <div>
              <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--accent-text);">Producto</div>
              <div style="font-weight:700;font-size:19px;letter-spacing:-0.01em;color:var(--text);">Financial OS</div>
            </div>
          </div>
          <p style="margin:20px 0 0;font-size:14.5px;line-height:1.62;color:var(--text-2);">Para empresas que necesitan gestionar operaciones, finanzas y reportería sin pagar por un sistema de seis cifras. Construido en módulos: empieza con lo que necesitas, agrega lo que crezca contigo.</p>
          <div style="display:flex;flex-direction:column;gap:11px;margin-top:22px;">
            {['Gestión de inventario y compras', 'Control financiero y flujo de caja', 'Reportería en tiempo real', 'Módulos adaptables a tu operación'].map((f) => (
              <div style="display:flex;align-items:center;gap:10px;font-size:14px;color:var(--text);"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 12 4 4 10-10" stroke="#4D6CFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>{f}</div>
            ))}
          </div>
          <div style="display:flex;align-items:center;gap:12px;margin-top:26px;padding-top:20px;border-top:1px solid var(--border);">
            <span style="display:inline-flex;align-items:center;gap:6px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.06em;text-transform:uppercase;color:var(--accent-text);background:var(--accent-soft);border:1px solid var(--accent-border);padding:5px 10px;border-radius:100px;">◷ Próximamente</span>
            <span style="font-size:13px;color:var(--text-3);">Suscríbete para ser notificado</span>
          </div>
        </div>
        <div style="position:relative;background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:32px;overflow:hidden;">
          <div style="position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#FF6A2C,transparent);"></div>
          <div style="display:flex;align-items:center;gap:13px;">
            <div style="display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:11px;background:#FF6A2C;font-family:'JetBrains Mono',monospace;font-weight:600;color:#fff;font-size:15px;">B</div>
            <div>
              <div style="font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:0.14em;text-transform:uppercase;color:var(--orange-text);">Producto</div>
              <div style="font-weight:700;font-size:19px;letter-spacing:-0.01em;color:var(--text);">Bulk Invoice</div>
            </div>
          </div>
