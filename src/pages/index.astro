---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import FormattedDate from '../components/FormattedDate.astro';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 2);

const WA = 'https://wa.me/50378410264';
---

<Layout title="Bitspace Software — Automatización operacional y software a medida">

  <!-- ═══════════════════════════════ HERO ══════════════════════════════════ -->
  <section class="relative pt-8 pb-12 sm:pt-12 sm:pb-16 md:pt-14 md:pb-20 px-4 sm:px-6 overflow-hidden">
    <div class="absolute -top-24 -left-24 w-80 h-80 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-blue-500/25 via-blue-400/15 to-transparent rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-24 -right-24 w-80 h-80 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-amber-500/10 via-orange-400/5 to-transparent rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

        <!-- Left: headline + CTAs -->
        <div class="text-center lg:text-left">
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-zinc-100 dark:bg-zinc-800 rounded-full mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-green-500 flex-shrink-0"></span>
            <span class="text-xs font-medium text-zinc-600 dark:text-zinc-400">15 años de experiencia · Automatización Operacional</span>
          </div>

          <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-zinc-900 dark:text-white leading-[1.08] mb-6">
            Automatizamos los procesos que
            <span class="text-primary-600 dark:text-amber-400"> frenan tu operación.</span>
          </h1>

          <p class="text-lg sm:text-xl text-zinc-600 dark:text-zinc-400 leading-relaxed mb-8 max-w-xl mx-auto lg:mx-0">
            Construimos software, automatizaciones e integraciones para empresas que necesitan operar con más control y menos fricción. Sin código genérico. Con foco en resultados concretos.
          </p>

          <div class="flex flex-col sm:flex-row gap-3 justify-center lg:justify-start">
            <a
              href={WA}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 font-semibold rounded-xl hover:bg-zinc-700 dark:hover:bg-zinc-100 transition-colors text-base"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Habla con nosotros
            </a>
            <a
              href="#servicios"
              data-scroll-to="servicios"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-300 font-semibold rounded-xl hover:bg-zinc-50 dark:hover:bg-zinc-800/50 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors text-base"
            >
              Ver servicios
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Right: 3 value cards -->
        <div class="flex flex-col gap-3">

          <div class="group flex gap-4 p-5 bg-white dark:bg-zinc-900/60 border border-zinc-200/70 dark:border-zinc-700/50 rounded-2xl hover:shadow-md hover:border-blue-200 dark:hover:border-blue-800/50 transition-all duration-300">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center shadow-md group-hover:scale-105 transition-transform duration-300">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-zinc-900 dark:text-white mb-1">Automatización de procesos</h3>
              <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">Eliminamos tareas manuales repetitivas que consumen tiempo y generan errores. Tus equipos se enfocan en lo que realmente importa.</p>
            </div>
          </div>

          <div class="group flex gap-4 p-5 bg-white dark:bg-zinc-900/60 border border-zinc-200/70 dark:border-zinc-700/50 rounded-2xl hover:shadow-md hover:border-amber-200 dark:hover:border-amber-800/50 transition-all duration-300">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-gradient-to-br from-amber-500 to-orange-500 flex items-center justify-center shadow-md group-hover:scale-105 transition-transform duration-300">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-zinc-900 dark:text-white mb-1">Integración de sistemas</h3>
              <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">Conectamos tus herramientas — ERP, CRM, facturación, logística — para que la información fluya sin intervención manual.</p>
            </div>
          </div>

          <div class="group flex gap-4 p-5 bg-white dark:bg-zinc-900/60 border border-zinc-200/70 dark:border-zinc-700/50 rounded-2xl hover:shadow-md hover:border-primary-200 dark:hover:border-primary-800/50 transition-all duration-300">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-gradient-to-br from-primary-500 to-primary-600 flex items-center justify-center shadow-md group-hover:scale-105 transition-transform duration-300">
              <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-zinc-900 dark:text-white mb-1">Control operacional</h3>
              <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">Dashboards y módulos de gestión para que veas en tiempo real qué pasa en tu operación y tomes decisiones con datos.</p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ PROBLEMAS ══════════════════════════════ -->
  <section id="problemas" class="py-16 sm:py-20 px-4 sm:px-6 bg-zinc-50 dark:bg-zinc-900/50">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-sm font-semibold text-primary-600 dark:text-amber-400 uppercase tracking-wider mb-3">Problemas que resolvemos</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white tracking-tight mb-4">
          ¿Tu empresa enfrenta alguno de estos problemas?
        </h2>
        <p class="text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto text-lg">
          Estos son los cuellos de botella operacionales que más vemos en empresas en crecimiento. Si alguno resuena, podemos ayudar.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">

        <div class="p-6 bg-white dark:bg-zinc-900 border border-zinc-200/70 dark:border-zinc-800 rounded-2xl">
          <div class="w-10 h-10 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-zinc-600 dark:text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
            </svg>
          </div>
          <h3 class="font-semibold text-zinc-900 dark:text-white mb-2">Procesos manuales que no escalan</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">Tu equipo ingresa datos en múltiples sistemas, copia información entre hojas de cálculo y pierde horas en tareas que deberían ser automáticas.</p>
        </div>

        <div class="p-6 bg-white dark:bg-zinc-900 border border-zinc-200/70 dark:border-zinc-800 rounded-2xl">
          <div class="w-10 h-10 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-zinc-600 dark:text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-semibold text-zinc-900 dark:text-white mb-2">Sistemas desconectados</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">Tu ERP no habla con tu tienda en línea. Tu CRM no se actualiza con las ventas. Cada integración es un proceso manual propenso a errores.</p>
        </div>

        <div class="p-6 bg-white dark:bg-zinc-900 border border-zinc-200/70 dark:border-zinc-800 rounded-2xl">
          <div class="w-10 h-10 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-zinc-600 dark:text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>
          <h3 class="font-semibold text-zinc-900 dark:text-white mb-2">Sin visibilidad real de la operación</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">Los reportes tardan días en estar listos. No sabes tu inventario real, tu caja actual o el estado de tus pedidos sin preguntarle a alguien.</p>
        </div>

        <div class="p-6 bg-white dark:bg-zinc-900 border border-zinc-200/70 dark:border-zinc-800 rounded-2xl">
          <div class="w-10 h-10 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-zinc-600 dark:text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="font-semibold text-zinc-900 dark:text-white mb-2">Facturación lenta y propensa a errores</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">Emitir cientos de facturas consume horas, requiere revisión manual y genera inconsistencias que llegan al cliente.</p>
        </div>

        <div class="p-6 bg-white dark:bg-zinc-900 border border-zinc-200/70 dark:border-zinc-800 rounded-2xl">
          <div class="w-10 h-10 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-zinc-600 dark:text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
          <h3 class="font-semibold text-zinc-900 dark:text-white mb-2">Crecimiento bloqueado por procesos rígidos</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">A medida que crece la operación, los procesos manuales colapsan. Lo que funcionaba con 5 personas ya no funciona con 20.</p>
        </div>

        <div class="p-6 bg-white dark:bg-zinc-900 border border-zinc-200/70 dark:border-zinc-800 rounded-2xl">
          <div class="w-10 h-10 rounded-xl bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-zinc-600 dark:text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="font-semibold text-zinc-900 dark:text-white mb-2">Dependencia total del desarrollo externo</h3>
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">Cualquier ajuste a flujos, reportes o configuraciones requiere contratar desarrollo. Tu operación no puede moverse a tu ritmo.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ SERVICIOS ══════════════════════════════ -->
  <section id="servicios" class="py-16 sm:py-20 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-sm font-semibold text-primary-600 dark:text-amber-400 uppercase tracking-wider mb-3">Capacidades</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white tracking-tight mb-4">
          Lo que construimos para resolverlos
        </h2>
        <p class="text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto text-lg">
          No vendemos proyectos de software genérico. Construimos herramientas operacionales que resuelven problemas concretos y se integran a cómo ya trabaja tu empresa.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <div class="p-7 bg-gradient-to-br from-blue-50 to-transparent dark:from-blue-950/25 dark:to-zinc-900 border border-blue-100 dark:border-blue-900/30 rounded-2xl flex flex-col">
          <div class="w-12 h-12 rounded-xl bg-blue-500 flex items-center justify-center mb-5 shadow-md flex-shrink-0">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-3">Automatización</h3>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-5 flex-1">
            Diseñamos flujos que corren solos: alertas automáticas, procesamiento de pedidos, sincronización entre sistemas, generación de documentos y notificaciones a equipos.
          </p>
          <div class="pt-4 border-t border-blue-100 dark:border-blue-900/30">
            <p class="text-sm font-medium text-blue-700 dark:text-blue-400">Resultado: menos errores, más velocidad de respuesta.</p>
          </div>
        </div>

        <div class="p-7 bg-gradient-to-br from-amber-50 to-transparent dark:from-amber-950/25 dark:to-zinc-900 border border-amber-100 dark:border-amber-900/30 rounded-2xl flex flex-col">
          <div class="w-12 h-12 rounded-xl bg-amber-500 flex items-center justify-center mb-5 shadow-md flex-shrink-0">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-3">Integraciones</h3>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-5 flex-1">
            Conectamos sistemas que hoy no se hablan: ERP con tienda en línea, CRM con facturación, logística con inventario. Creamos el puente que faltaba sin reemplazar lo que ya tienes.
          </p>
          <div class="pt-4 border-t border-amber-100 dark:border-amber-900/30">
            <p class="text-sm font-medium text-amber-700 dark:text-amber-400">Resultado: operación fluida sin cambiar de plataforma.</p>
          </div>
        </div>

        <div class="p-7 bg-gradient-to-br from-primary-50 to-transparent dark:from-primary-900/20 dark:to-zinc-900 border border-primary-100 dark:border-primary-900/30 rounded-2xl flex flex-col">
          <div class="w-12 h-12 rounded-xl bg-primary-500 flex items-center justify-center mb-5 shadow-md flex-shrink-0">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-3">Software operacional</h3>
          <p class="text-zinc-600 dark:text-zinc-400 leading-relaxed mb-5 flex-1">
            Cuando las herramientas genéricas no bastan, construimos módulos a medida: gestión de contratos, control de inventario, paneles de seguimiento, sistemas de aprobaciones y reportería.
          </p>
          <div class="pt-4 border-t border-primary-100 dark:border-primary-900/30">
            <p class="text-sm font-medium text-primary-700 dark:text-primary-400">Resultado: control total sin depender de hojas de cálculo.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════ PRODUCTOS ═════════════════════════════ -->
  <section id="productos" class="py-16 sm:py-20 px-4 sm:px-6 bg-zinc-50 dark:bg-zinc-900/50">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-sm font-semibold text-primary-600 dark:text-amber-400 uppercase tracking-wider mb-3">Productos</p>
        <h2 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-white tracking-tight mb-4">
          Soluciones listas para operar
        </h2>
        <p class="text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto text-lg">
          Además de proyectos a medida, desarrollamos productos propios que resuelven problemas operacionales frecuentes. Más rápidos de implementar. Adaptables a tu operación.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">

        <!-- Financial OS -->
        <div class="group relative overflow-hidden p-7 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl hover:shadow-lg transition-shadow">
          <div class="absolute top-0 right-0 w-40 h-40 bg-blue-50 dark:bg-blue-950/20 rounded-full -translate-y-1/2 translate-x-1/2 blur-2xl pointer-events-none"></div>
