<script>
  // ── Subscribe forms ───────────────────────────────────────────────────────
  async function submitSubscribe(product: string, nameId: string, emailId: string, msgId: string, btnId: string) {
    const name = (document.getElementById(nameId) as HTMLInputElement)?.value.trim();
    const email = (document.getElementById(emailId) as HTMLInputElement)?.value.trim();
    const msg = document.getElementById(msgId);
    const btn = document.getElementById(btnId) as HTMLButtonElement;

    if (!name || !email) {
      if (msg) { msg.textContent = 'Por favor completa nombre y correo.'; msg.className = 'text-xs text-center text-red-500 font-medium'; msg.classList.remove('hidden'); }
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Enviando...';

    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, product }),
      });
      const data = await res.json();
      if (res.ok && data.success) {
        if (msg) { msg.textContent = '¡Listo! Te avisamos cuando esté disponible.'; msg.className = 'text-xs text-center text-green-600 dark:text-green-400 font-medium'; msg.classList.remove('hidden'); }
        btn.classList.add('hidden');
      } else {
        throw new Error(data.error ?? 'Error');
      }
    } catch (err: any) {
      if (msg) { msg.textContent = err.message ?? 'Ocurrió un error. Intenta de nuevo.'; msg.className = 'text-xs text-center text-red-500 font-medium'; msg.classList.remove('hidden'); }
      btn.disabled = false;
      btn.textContent = 'Notifícame';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    // Toggle forms
    document.getElementById('subscribe-financial-trigger')?.addEventListener('click', () => {
      document.getElementById('subscribe-financial-form')?.classList.toggle('hidden');
    });
    document.getElementById('subscribe-bulk-trigger')?.addEventListener('click', () => {
      document.getElementById('subscribe-bulk-form')?.classList.toggle('hidden');
    });

    // Submit handlers
    document.getElementById('fin-submit')?.addEventListener('click', () =>
      submitSubscribe('Financial OS', 'fin-name', 'fin-email', 'fin-msg', 'fin-submit'));
    document.getElementById('bulk-submit')?.addEventListener('click', () =>
      submitSubscribe('Bulk Invoice', 'bulk-name', 'bulk-email', 'bulk-msg', 'bulk-submit'));
  });
</script>

