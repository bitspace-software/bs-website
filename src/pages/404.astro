---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Página no encontrada">
  <div style="position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:78vh;padding:80px 24px;text-align:center;">
    <div style="font-family:'JetBrains Mono',monospace;font-size:13px;letter-spacing:0.18em;text-transform:uppercase;color:var(--accent-text);font-weight:500;">Error 404</div>
    <h1 style="margin:18px 0 0;font-weight:800;font-size:clamp(72px,18vw,160px);line-height:0.95;letter-spacing:-0.04em;color:var(--text);">404</h1>
    <h2 style="margin:14px 0 0;font-weight:700;font-size:clamp(22px,3.4vw,30px);letter-spacing:-0.02em;color:var(--text);">Esta página se perdió en la operación</h2>
    <p style="margin:16px 0 0;max-width:460px;font-size:16px;line-height:1.6;color:var(--text-2);">El enlace que seguiste no existe o se movió. Volvamos a un lugar conocido.</p>

    <div style="display:flex;flex-wrap:wrap;gap:14px;justify-content:center;margin-top:34px;">
      <a href="/" style="display:inline-flex;align-items:center;gap:9px;background:#4D6CFF;color:#fff;font-weight:600;font-size:15px;padding:14px 24px;border-radius:9px;box-shadow:0 8px 28px rgba(77,108,255,0.35);">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5M5.5 10v9.5a1 1 0 0 0 1 1H17.5a1 1 0 0 0 1-1V10" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        Volver al inicio
      </a>
      <button id="back-button" type="button" style="display:inline-flex;align-items:center;gap:9px;background:transparent;color:var(--text);font-weight:600;font-size:15px;padding:14px 22px;border-radius:9px;border:1px solid var(--border-2);cursor:pointer;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M10.5 19.5 3 12l7.5-7.5M3 12h18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
        Regresar
      </button>
    </div>

    <a href="/blog" style="margin-top:34px;font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--text-3);text-decoration:underline;text-underline-offset:3px;">¿Buscabas el blog? →</a>
  </div>
</Layout>

<script is:inline>
  document.getElementById('back-button')?.addEventListener('click', function () {
    if (history.length > 1) history.back();
    else window.location.href = '/';
  });
</script>
