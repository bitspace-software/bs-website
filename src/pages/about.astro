---
import Layout from '../layouts/Layout.astro';

const WA = 'https://wa.me/50378410264';

const principles = [
  {
    t: 'Resolvemos problemas, no vendemos horas',
    d: 'No facturamos tiempo de desarrollo sin un problema definido. Cada proyecto empieza por entender qué proceso falla y por qué — y termina cuando ese problema deja de existir.',
  },
  {
    t: 'Tecnología madura y probada',
    d: 'Usamos herramientas con soporte a largo plazo y comunidades sólidas. No perseguimos tendencias: elegimos lo que mantiene tu operación estable durante años.',
  },
  {
    t: 'Entregas cortas e iterativas',
    d: 'Construimos en ciclos breves. Ves resultados reales desde las primeras semanas, ajustamos sobre la marcha y evitamos proyectos de seis meses que entregan al final.',
  },
  {
    t: 'Soluciones que tu equipo puede operar',
    d: 'Entregamos software que tu gente usa sin depender de nosotros para cada cambio. La autonomía de tu operación es parte del resultado, no un extra.',
  },
];
---

<Layout
  title="Acerca de Bitspace — Nosotros"
  description="Bitspace Software es un estudio que construye automatizaciones, integraciones y software operacional a medida para empresas que ya operan. 15 años de experiencia."
>
  <!-- ===== HERO / INTRO ===== -->
  <section id="top" style="position:relative;z-index:1;max-width:1000px;margin:0 auto;padding:96px 24px 80px;text-align:center;">
    <div style="display:inline-flex;align-items:center;gap:9px;border:1px solid var(--border-2);background:var(--surface);border-radius:100px;padding:6px 13px;font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:0.12em;text-transform:uppercase;color:var(--text-2);">
      <span style="width:7px;height:7px;border-radius:50%;background:#2FCB72;box-shadow:0 0 10px #2FCB72;animation:bsPulse 1.8s ease-in-out infinite;"></span>
      Nosotros · Estudio de software
    </div>
    <h1 style="margin:26px 0 0;font-weight:800;font-size:clamp(34px,5.2vw,62px);line-height:1.04;letter-spacing:-0.035em;color:var(--text);">
      Construimos el software que <span style="color:var(--accent-text);">hace funcionar tu operación.</span>
    </h1>
    <p style="margin:24px auto 0;max-width:620px;font-size:18px;line-height:1.62;color:var(--text-2);">
      Bitspace Software es un estudio que construye automatizaciones, integraciones y software operacional a medida para empresas que ya operan. No vendemos plantillas ni proyectos genéricos: resolvemos los cuellos de botella concretos que frenan a empresas en crecimiento.
    </p>
    <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:14px 28px;margin-top:38px;padding-top:28px;border-top:1px solid var(--hair);font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--text-3);letter-spacing:0.01em;">
      <span><span style="color:var(--text);font-weight:600;">15 años</span> de experiencia</span>
      <span style="color:var(--border-2);">/</span>
      <span>Empresas de <span style="color:var(--text);font-weight:600;">10–200</span> personas</span>
      <span style="color:var(--border-2);">/</span>
      <span>Manufactura · Servicios · Logística</span>
    </div>
  </section>

  <!-- ===== MISIÓN / ENFOQUE ===== -->
  <section style="position:relative;z-index:1;background:var(--bg-alt);border-top:1px solid var(--hair);border-bottom:1px solid var(--hair);">
    <div style="max-width:1000px;margin:0 auto;padding:100px 24px;" data-r="pad">
      <div style="text-align:center;max-width:640px;margin:0 auto;">
        <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:var(--accent-text);font-weight:500;">Por qué existimos</div>
        <h2 style="margin:16px 0 0;font-weight:700;font-size:clamp(30px,4vw,46px);line-height:1.05;letter-spacing:-0.025em;color:var(--text);">El problema casi nunca es la tecnología</h2>
        <p style="margin:18px 0 0;font-size:17px;line-height:1.6;color:var(--text-2);">
          La mayoría de los obstáculos que vemos en empresas medianas no son problemas de software — son problemas de operación que la tecnología correcta puede resolver: procesos manuales que no escalan, sistemas que no se hablan entre sí y falta de visibilidad real sobre lo que pasa cada día.
        </p>
      </div>
      <div style="max-width:760px;margin:40px auto 0;background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:32px;">
        <p style="margin:0;font-size:16px;line-height:1.66;color:var(--text-2);">
          Bitspace existe para eso: para que las empresas puedan crecer sin que sus procesos internos se conviertan en el cuello de botella. Cuando la operación deja de pelear con sus propias herramientas, el equipo recupera horas, los errores caen y la empresa puede escalar a su ritmo — no al ritmo que permiten las hojas de cálculo. Ese es el resultado que perseguimos en cada proyecto.
        </p>
      </div>
    </div>
  </section>

  <!-- ===== PRINCIPIOS ===== -->
  <section style="position:relative;z-index:1;max-width:1100px;margin:0 auto;padding:100px 24px;" data-r="pad">
    <div style="text-align:center;max-width:600px;margin:0 auto;">
      <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:var(--accent-text);font-weight:500;">Cómo trabajamos</div>
      <h2 style="margin:16px 0 0;font-weight:700;font-size:clamp(30px,4vw,46px);line-height:1.05;letter-spacing:-0.025em;color:var(--text);">Principios que no negociamos</h2>
      <p style="margin:18px 0 0;font-size:17px;line-height:1.6;color:var(--text-2);">La forma en que trabajamos es tan importante como lo que construimos. Estos son los principios que guían cada decisión.</p>
    </div>
    <div data-r="grid2" style="display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:54px;">
      {principles.map((p, i) => (
        <div style="background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:30px;">
          <div style="font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--accent-text);font-weight:600;">{String(i + 1).padStart(2, '0')}</div>
          <h3 style="margin:14px 0 10px;font-weight:700;font-size:19px;letter-spacing:-0.015em;color:var(--text);">{p.t}</h3>
          <p style="margin:0;font-size:14.5px;line-height:1.62;color:var(--text-2);">{p.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ===== FOUNDER ===== -->
  <section style="position:relative;z-index:1;background:var(--bg-alt);border-top:1px solid var(--hair);border-bottom:1px solid var(--hair);">
    <div style="max-width:980px;margin:0 auto;padding:100px 24px;text-align:center;" data-r="pad">
      <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:var(--accent-text);font-weight:500;">Quién está detrás</div>
      <h2 style="margin:16px 0 0;font-weight:700;font-size:clamp(28px,3.6vw,40px);line-height:1.07;letter-spacing:-0.025em;color:var(--text);">Un fundador, 15 años en operaciones reales</h2>
      <div style="max-width:720px;margin:44px auto 0;background:var(--surface);border:1px solid var(--border);border-radius:18px;padding:38px 40px;text-align:left;">
        <div style="font-family:Georgia,serif;font-size:46px;line-height:0;color:var(--accent);">”</div>
        <p style="margin:6px 0 0;font-size:19px;line-height:1.55;letter-spacing:-0.01em;color:var(--text);font-weight:500;">
          Después de 15 años construyendo software dentro y para empresas, aprendí que el código es la parte fácil. Lo difícil — y lo que de verdad importa — es entender cómo trabaja una operación y construir algo que el equipo realmente use. Por eso fundé Bitspace: para resolver problemas operacionales con seriedad, no para vender horas de desarrollo.
        </p>
        <div style="display:flex;align-items:center;gap:13px;margin-top:26px;">
          <div style="width:48px;height:48px;border-radius:50%;background:linear-gradient(135deg,#4D6CFF,#9B6BFF);display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:15px;color:#fff;">MB</div>
          <div>
            <div style="font-weight:600;font-size:15px;color:var(--text);">Marlon Beltrán</div>
            <div style="font-size:12.5px;color:var(--text-3);">Founder · Bitspace Software · 15 años de experiencia</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CTA FINAL (always dark) ===== -->
  <section id="contacto" style="position:relative;z-index:1;padding:90px 24px;">
    <div style="position:relative;max-width:1000px;margin:0 auto;background:linear-gradient(180deg,#0E1120,#0A0B10);border:1px solid #232842;border-radius:24px;padding:72px 40px;text-align:center;overflow:hidden;">
      <div style="position:absolute;top:-120px;left:50%;transform:translateX(-50%);width:680px;height:420px;background:radial-gradient(ellipse at center,rgba(77,108,255,0.28),transparent 65%);pointer-events:none;"></div>
      <div style="position:relative;z-index:1;">
        <div style="font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:0.18em;text-transform:uppercase;color:#FFB37A;font-weight:500;">Hablemos</div>
        <h2 style="margin:18px auto 0;max-width:620px;font-weight:800;font-size:clamp(32px,4.4vw,50px);line-height:1.05;letter-spacing:-0.03em;color:#F7F7F8;">¿Conversamos sobre tu operación?</h2>
        <p style="margin:22px auto 0;max-width:540px;font-size:17px;line-height:1.62;color:#A6A9B3;">Si tienes un proceso manual que debería ser automático o sistemas que no se hablan entre sí, agenda una conversación. La primera es sin costo y sin compromiso.</p>
        <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:14px;margin-top:34px;">
          <a href={WA} target="_blank" rel="noopener noreferrer" style="display:inline-flex;align-items:center;gap:9px;background:#4D6CFF;color:#fff;font-weight:600;font-size:15.5px;padding:15px 26px;border-radius:9px;box-shadow:0 10px 30px rgba(77,108,255,0.4);">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Z" stroke="#fff" stroke-width="1.8" /><path d="M8.5 9.2c.2-.5.4-.5.6-.5h.5c.2 0 .4 0 .6.4l.7 1.6c.1.2 0 .4-.1.6l-.5.5c-.1.1-.2.3-.1.5.3.6 1.4 1.9 2.7 2.3.2.1.4 0 .5-.1l.5-.6c.2-.2.3-.2.6-.1l1.6.8c.2.1.3.3.3.5 0 .9-.7 1.6-1.6 1.6-2.7 0-6.6-3.9-6.6-6.6 0-.5.2-.9.4-1.3Z" fill="#fff" /></svg>
            Agendar una conversación
          </a>
          <a href="mailto:hola@bitspace.software" style="display:inline-flex;align-items:center;gap:9px;background:transparent;color:#E6E7EB;font-weight:600;font-size:15.5px;padding:15px 24px;border-radius:9px;border:1px solid #2E3346;">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5" stroke="#E6E7EB" stroke-width="1.7" /><path d="m4 7 8 6 8-6" stroke="#E6E7EB" stroke-width="1.7" /></svg>
            hola@bitspace.software
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  @media (max-width: 760px) {
    [data-r="grid2"] { grid-template-columns: 1fr !important; }
    [data-r="pad"] { padding-top: 60px !important; padding-bottom: 60px !important; }
  }
</style>
